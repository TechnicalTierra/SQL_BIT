/*Query #1: Rewrite the following query using an IN() clause. In other words, copy and paste the following query into db-fiddle, and change the WHERE clause to use IN.
SELECT product_name, description
FROM bank_products
WHERE product_name ='Premium Checking'
OR product_name ='High Yield Savings'
OR product_name ='Platinum Credit Card'
OR product_name ='Gold Credit Card';*/ 
SELECT product_name, description
FROM bank_products
WHERE product_name IN ("Premium Checking", "High Yield Savings", "Platinum Credit Card", "Gold Credit Card");

/*Query #2: You know that your bank offers a service for businesses. Use LIKE to list the product name that starts with the word “Business”.*/
SELECT *
FROM bank_products
WHERE product_name LIKE "%Business%"; 

/*Query #3: A new customer wants something with rewards. Show the name and description for all products that have the word “reward” in either the name or description.*/ 
SELECT product_name, description
FROM bank_products
WHERE product_name LIKE "%reward%" 
OR description LIKE "%reward%";
