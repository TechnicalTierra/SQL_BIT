/*Query #1: Write a query that selects the names of products in the table bank_products.*/
SELECT product_name
FROM bank_products;

/*Query #2: This customer is interested in opening a Checking or Savings account, but wants more information on the options.*/
SELECT product_name, product_type
FROM bank_products
WHERE product_type is "Checking" 
OR product_type = "Savings";

/*Query #3: The customer decided they want a savings account with a good interest rate and no monthly fee. (Write a query that shows the product name and interest rate for products with a “Savings” product type, an interest_rate greater than or equal to .75, and a monthly fee of 0.)*/ 
SELECT *
FROM bank_products
WHERE product_type = "Savings"
AND interest_rate >= 0.75 
AND monthly_fee = 0;
