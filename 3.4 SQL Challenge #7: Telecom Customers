/*Query #3: Write a query that will select the emails of all customers who are paying more than the average price for internet.*/ 
-- Step 1: inner query (paying more than avg price for internet)
SELECT avg(monthly_price)
FROM products
WHERE product_type = "Internet";

-- Step 2: outer query (emails of customers)
SELECT email 
FROM customer_subscriptions
--WHERE monthly_price IN ()

-- Step 3: combine queries
SELECT email 
FROM customer_subscriptions
WHERE price > (SELECT avg(monthly_price)
FROM products
WHERE product_type = "Internet"); 

