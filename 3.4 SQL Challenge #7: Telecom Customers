/*Query #2: Now that we’ve practiced building a subquery together, you can build on yourself! Write a query that will select the email address of all the customers with the "Internet" product type.*/ 
-- Step 1: inner query (select 'internet' product type)
SELECT product_id
FROM products
WHERE product_type = "Internet";

-- Step 2: outer query (select email addresS)
SELECT email
FROM customer_subscriptions
--WHERE product_id IN ()*/

-- Step 3: combine queries
SELECT email
FROM customer_subscriptions
WHERE product_id IN (SELECT product_id
FROM products
WHERE product_type = "Internet");
